    affiliation: "DIAG, Sapienza University of Rome"
url: "https://fabiofurini.github.io/algorithms/"
repository-code: "https://github.com/fabiofurini/algorithms"
license:
  - CC-BY-4.0
  - MIT
date-released: 2026-10-11
keywords:
  - algorithms
  - pseudo-code
  - C++
  - sorting
  - running time
  - correctness
  - recursion
  - Master Theorem
  - teaching material
